name: Print First Pipeline

on:
  push:
      branches:
        - main
  pull_request:
      branches:
        - main
  workflow_dispatch:
        
 



jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Showing demo to Naveen
        run: echo "Hello, I am Naveen"

      - name: Mentor by Shaik
        run: echo "Mentor by Shaik"

      - name: Print Linux commands
        run: |
          pwd
          whoami
          date
          du
          free


  test:
    runs-on: ubuntu-latest
    needs: build

    steps:
      - name: Testing the test job
        run: echo "Hi, I am test step from test job"

      - name: Test step 2
        run: echo "I am second step"


  deploy:
    runs-on: ubuntu-latest
    needs: test

    # Manual approval is configured on this environment
    environment:
      name: production

    # Job-level condition
    if: github.ref == 'refs/heads/main'

    steps:
      - name: Deploying
        run: echo "Deploying into the target server/environment"

      - name: Status check
        run: echo "Checking the deployment"
